{{- $posts := site.RegularPages -}}
{
  "site": "yojnaportal",
  "posts": [
    {{- range $i, $post := $posts -}}
    {{- if $i }},{{ end -}}
    {
      "id": {{ $post.File.UniqueID | jsonify }},
      "title": {{ $post.Title | jsonify }},
      "url": {{ $post.Permalink | jsonify }},
      "published_at": {{ $post.Date.Format "2006-01-02T15:04:05-07:00" | jsonify }}
    }
    {{- end -}}
  ]
}