{{- $pages := where site.RegularPages "Params.post-type" "schemes" -}}
[
{{- range $i, $p := $pages -}}
    {{- if $i }},{{ end -}}
    {
        "title": {{ $p.Title | jsonify }},
        "state": {{ $p.Params.state | default "" | jsonify }},
        "category": {{ $p.Params.category | default "" | jsonify }},
        "description": {{ $p.Params.description | default $p.Summary | plainify | jsonify }},
        "button": {{ $p.Params.button | default "View Details" | jsonify }},
        "url": {{ $p.Permalink | jsonify }}
    }
{{- end -}}
]