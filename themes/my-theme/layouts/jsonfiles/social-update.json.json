[
  {{- range $i, $p := first 20 ((where site.RegularPages "Section" "ne" "farmate").ByDate.Reverse) -}}
  {{- if $i }},{{ end }}
  {
    "id": {{ $p.File.UniqueID | default $p.RelPermalink | jsonify }},
    
    "title": {{ with $p.Params.seo_title }} {{ . | jsonify }}{{ else }}{{ $p.Title | jsonify }}{{ end }},

    "content": {{ with $p.Params.Hindi_Sharing }} {{ index . 0 | jsonify }}{{ else }}{{ with $p.Params.Description }}{{ . | jsonify }}{{ else }} {{ $p.Summary | plainify | jsonify }}{{ end }}{{ end }},

    "type": "image",

    "sender": "Yojna Portal - Jobs & Schemes",

    "sender_id": "yojna-portal-official",

    "sender_logo": "https://www.yojnaportal.com/favicon.ico",

    "sender_website": "https://www.yojnaportal.com",

    "image_url": {{ with $p.Params.imagePoster }} {{ . | jsonify }} {{ else }} {{ with $p.Params.imageBanner }}{{ . | jsonify }} {{ else }} {{ "" | jsonify }} {{ end }}{{ end }},

    "image_download_allowed": false,

    "link_url": {{ $p.Permalink | jsonify }},

    "pin": false,

    "publish_at": {{ $p.Date.Format "2006-01-02T15:04:05Z07:00" | jsonify }}
  }
  {{- end }}
]